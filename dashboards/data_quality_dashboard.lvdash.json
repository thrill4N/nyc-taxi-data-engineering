{
  "datasets": [
    {
      "name": "silver_quality_flags",
      "displayName": "Silver Quality Flags",
      "queryLines": [
        "SELECT\n",
        "  'Negative Fares' AS flag_name,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN flag_negative_fare THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS count\n",
        "FROM\n",
        "  nyc_taxi.pipeline.silver_yellow_tripdata_sample\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Neg/Zero Duration',\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN flag_negative_or_zero_duration THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  )\n",
        "FROM\n",
        "  nyc_taxi.pipeline.silver_yellow_tripdata_sample\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Zero Passengers',\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN flag_zero_passenger THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  )\n",
        "FROM\n",
        "  nyc_taxi.pipeline.silver_yellow_tripdata_sample\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Clean Rows',\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        NOT (\n",
        "          flag_negative_fare\n",
        "          OR flag_negative_or_zero_duration\n",
        "          OR flag_zero_passenger\n",
        "        )\n",
        "      THEN\n",
        "        1\n",
        "      ELSE 0\n",
        "    END\n",
        "  )\n",
        "FROM\n",
        "  nyc_taxi.pipeline.silver_yellow_tripdata_sample\n",
        "ORDER BY\n",
        "  count DESC"
      ]
    },
    {
      "name": "silver_schema_validation",
      "displayName": "Silver Schema Validation",
      "queryLines": [
        "SELECT\n",
        "  year_month,\n",
        "  report_json,\n",
        "  validated_at\n",
        "FROM\n",
        "  nyc_taxi.pipeline.silver_schema_validation_sample"
      ]
    },
    {
      "name": "bronze_quality_metrics",
      "displayName": "Bronze Quality Metrics",
      "queryLines": [
        "SELECT\n",
        "  year_month,\n",
        "  report_json,\n",
        "  recorded_at\n",
        "FROM\n",
        "  nyc_taxi.pipeline.bronze_quality_metrics_sample"
      ]
    },
    {
      "name": "cross_table_consistency",
      "displayName": "Cross-Table Consistency",
      "queryLines": [
        "SELECT\n",
        "  'Bronze (raw)' AS layer,\n",
        "  COUNT(*) AS row_count\n",
        "FROM\n",
        "  nyc_taxi.pipeline.bronze_yellow_tripdata_sample\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Silver (cleaned)',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  nyc_taxi.pipeline.silver_yellow_tripdata_sample\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Gold - Hourly groups',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  nyc_taxi.pipeline.gold_hourly_summary_sample\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Gold - Day-of-week groups',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  nyc_taxi.pipeline.gold_day_of_week_summary_sample\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Gold - Top routes',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  nyc_taxi.pipeline.gold_route_summary_sample"
      ]
    },
    {
      "name": "pipeline_row_counts",
      "displayName": "Pipeline Row Counts",
      "queryLines": [
        "SELECT\n",
        "  'bronze_yellow_tripdata_sample' AS table_name,\n",
        "  COUNT(*) AS row_count\n",
        "FROM\n",
        "  nyc_taxi.pipeline.bronze_yellow_tripdata_sample\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'silver_yellow_tripdata_sample',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  nyc_taxi.pipeline.silver_yellow_tripdata_sample\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'gold_hourly_summary_sample',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  nyc_taxi.pipeline.gold_hourly_summary_sample\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'gold_day_of_week_summary_sample',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  nyc_taxi.pipeline.gold_day_of_week_summary_sample\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'gold_route_summary_sample',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  nyc_taxi.pipeline.gold_route_summary_sample\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'bronze_quality_metrics_sample',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  nyc_taxi.pipeline.bronze_quality_metrics_sample\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'silver_schema_validation_sample',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  nyc_taxi.pipeline.silver_schema_validation_sample\n",
        "ORDER BY\n",
        "  row_count DESC"
      ]
    },
    {
      "name": "dow_summary",
      "displayName": "Day of Week Summary",
      "queryLines": [
        "SELECT\n",
        "  pickup_day_of_week,\n",
        "  trip_count,\n",
        "  avg_fare,\n",
        "  avg_tip_pct,\n",
        "  year_month\n",
        "FROM\n",
        "  nyc_taxi.pipeline.gold_day_of_week_summary_sample\n",
        "ORDER BY\n",
        "  trip_count DESC"
      ]
    },
    {
      "name": "hourly_summary",
      "displayName": "Hourly Summary",
      "queryLines": [
        "SELECT\n",
