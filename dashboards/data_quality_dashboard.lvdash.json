        "  DOLocationID,\n",
        "  trip_count,\n",
        "  year_month\n",
        "FROM\n",
        "  nyc_taxi.pipeline.gold_route_summary_sample\n",
        "ORDER BY\n",
        "  trip_count DESC"
      ]
    }
