        "  trip_count,\n",
        "  avg_fare,\n",
        "  avg_distance,\n",
        "  total_revenue,\n",
        "  year_month\n",
        "FROM\n",
        "  nyc_taxi.pipeline.gold_hourly_summary_sample\n",
        "ORDER BY\n",
        "  pickup_hour"
      ]
    },
    {
