{
  "datasets": [
    {
      "name": "top_routes",
      "displayName": "Top Routes",
      "queryLines": [
        "SELECT\n",
        "  PULocationID,\n",
        "  DOLocationID,\n",
        "  trip_count,\n",
        "  year_month\n",
        "FROM\n",
        "  nyc_taxi.pipeline.gold_route_summary_sample\n",
        "ORDER BY\n",
        "  trip_count DESC"
      ]
    },
    {
      "name": "dow_trips",
      "displayName": "Day of Week Trips",
      "queryLines": [
        "SELECT\n",
        "  pickup_day_of_week,\n",
        "  trip_count,\n",
        "  avg_fare,\n",
        "  avg_tip_pct,\n",
        "  year_month\n",
        "FROM\n",
        "  nyc_taxi.pipeline.gold_day_of_week_summary_sample\n",
        "ORDER BY\n",
        "  trip_count DESC"
      ]
    },
    {
      "name": "hourly_trips",
      "displayName": "Hourly Trips",
      "queryLines": [
        "SELECT\n",
        "  pickup_hour,\n",
        "  trip_count,\n",
        "  avg_fare,\n",
        "  avg_distance,\n",
        "  total_revenue,\n",
        "  year_month\n",
        "FROM\n",
        "  nyc_taxi.pipeline.gold_hourly_summary_sample\n",
        "ORDER BY\n",
        "  pickup_hour"
      ]
    }
  ],
